<?xml version="1.0" ?>

<sdf version="1.6">

  <world name="obstacle_world">

    <!-- ====================== -->
    <!-- Ground -->
    <!-- ====================== -->

    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- ====================== -->
    <!-- Sun -->
    <!-- ====================== -->

    <include>
      <uri>model://sun</uri>
    </include>


    <!-- ====================== -->
    <!-- Obstacle 1 -->
    <!-- ====================== -->

    <model name="obstacle_1">

      <static>true</static>

      <pose>2 0 0.5 0 0 0</pose>

      <link name="link">

        <collision name="collision">

          <geometry>
            <box>
              <size>1 1 1</size>
            </box>
          </geometry>

        </collision>

        <visual name="visual">

          <geometry>
            <box>
              <size>1 1 1</size>
            </box>
          </geometry>

        </visual>

      </link>

    </model>


    <!-- ====================== -->
    <!-- Obstacle 2 -->
    <!-- ====================== -->

    <model name="obstacle_2">

      <static>true</static>

      <pose>4 1.5 0.5 0 0 0</pose>

      <link name="link">

        <collision name="collision">

          <geometry>
            <box>
              <size>1 1 1</size>
            </box>
          </geometry>

        </collision>

        <visual name="visual">

          <geometry>
            <box>
              <size>1 1 1</size>
            </box>
          </geometry>

        </visual>

      </link>

    </model>


    <!-- ====================== -->
    <!-- Obstacle 3 -->
    <!-- ====================== -->

    <model name="obstacle_3">

      <static>true</static>

      <pose>4 -1.5 0.5 0 0 0</pose>

      <link name="link">

        <collision name="collision">

          <geometry>
            <box>
              <size>1 1 1</size>
            </box>
          </geometry>

        </collision>

        <visual name="visual">

          <geometry>
            <box>
              <size>1 1 1</size>
            </box>
          </geometry>

        </visual>

      </link>

    </model>


    <!-- ====================== -->
    <!-- Long wall -->
    <!-- ====================== -->

    <model name="wall">

      <static>true</static>

      <pose>6 0 0.5 0 0 0</pose>

      <link name="link">

        <collision name="collision">

          <geometry>
            <box>
              <size>0.5 5 1</size>
            </box>
          </geometry>

        </collision>

        <visual name="visual">

          <geometry>
            <box>
              <size>0.5 5 1</size>
            </box>
          </geometry>

        </visual>

      </link>

    </model>
        <!-- ====================== -->
  <!-- Goal -->
  <!-- ====================== -->

  <model name="goal">

    <static>true</static>

    <pose>8 0 0.5 0 0 0</pose>

    <link name="link">

      <visual name="visual">

        <geometry>
          <cylinder>
            <radius>0.35</radius>
            <length>0.05</length>
          </cylinder>
        </geometry>

        <material>
          <ambient>0 1 0 1</ambient>
          <diffuse>0 1 0 1</diffuse>
          <specular>0 0 0 1</specular>
        </material>

      </visual>

    </link>

  </model>
  </world>

</sdf>
